# Copy this file to .env and fill in the actual values locally.
# NEVER commit .env or camera credentials.

CAMERA_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=1&subtype=1

# Process every Nth frame with AI. Increase this on slower PCs.
DETECT_EVERY=3

# Horizontal counting line, from 0.0 (top) to 1.0 (bottom).
COUNT_LINE_Y=0.60

# Generate a stopped-vehicle incident after this many seconds.
STOPPED_SECONDS=240

# Local-only OCR. More CPU intensive.
ENABLE_PLATE_OCR=false

# YOLO model. First use may download the model.
YOLO_MODEL=yolo11n.pt
