# AutoGearUp CCTV Analytics Gateway
# Copy to .env. Keep all RTSP credentials local and NEVER commit .env.

# ---------------------------------------------------------------------------
# Cameras
# ---------------------------------------------------------------------------
# Use Lorex/NVR SUBSTREAMS for continuous AI wherever possible.
# Add CAMERA5_... through CAMERA32_... using the same format when needed.
MAX_CAMERAS=32

CAMERA1_NAME=Front
CAMERA1_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=1&subtype=1

CAMERA2_NAME=Parking
CAMERA2_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=2&subtype=1

CAMERA3_NAME=Service Drive
CAMERA3_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=3&subtype=1

CAMERA4_NAME=Rear Lot
CAMERA4_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=4&subtype=1

# Example additional feeds:
# CAMERA5_NAME=Bay 5
# CAMERA5_RTSP_URL=rtsp://USERNAME:PASSWORD@NVR:554/cam/realmonitor?channel=5&subtype=1

# ---------------------------------------------------------------------------
# Shared batched AI
# ---------------------------------------------------------------------------
# ONE model is loaded for all cameras.
YOLO_MODEL=yolo26s.pt

# auto = NVIDIA GPU when CUDA is available, otherwise CPU.
# For an NVIDIA box you can explicitly use 0.
INFERENCE_DEVICE=auto

# Analyze each camera roughly this many times per second.
# 3 FPS is a strong starting point for parking/shop movement analytics.
ANALYTICS_FPS=3

# Number of camera frames sent to the detector together.
# 8 is a good starting point; try 12-16 on a larger GPU after benchmarking.
ANALYTICS_BATCH_SIZE=8

# 640 is substantially cheaper than 960 and is better suited to 16-30 feeds.
DETECTION_IMGSZ=640
DETECTION_CONFIDENCE=0.22
DETECTION_IOU=0.55
MAX_DETECTIONS=120

# Lightweight per-camera tracking after shared object detection.
TRACK_TTL_SECONDS=2.0
TRACK_IOU_THRESHOLD=0.20
TRACK_CENTER_RATIO=0.12

# Count a unique track once it has visibly moved through any camera.
PASS_MOVEMENT_RATIO=0.035
PASS_MIN_TRACK_SECONDS=0.35

# Incident rule.
STOPPED_SECONDS=240

# Plate OCR is event-driven and disabled by default for maximum scale.
ENABLE_PLATE_OCR=false
PLATE_OCR_INTERVAL=2.0

# Browser stream quality. Lorex remains responsible for recording.
JPEG_QUALITY=76

# AutoGearUp stores metadata/events only.
DATABASE_PATH=cctv.db

# ---------------------------------------------------------------------------
# Secure remote sharing
# ---------------------------------------------------------------------------
REMOTE_ACCESS_KEY=
REMOTE_ALLOWED_ORIGIN=https://tanvirfuad.github.io
