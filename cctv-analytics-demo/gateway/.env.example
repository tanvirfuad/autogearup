# Copy this file to .env and enter the real RTSP links locally.
# NEVER commit .env or camera passwords to GitHub.

# Existing installations may keep CAMERA_RTSP_URL for Camera 1.
# CAMERA1_RTSP_URL takes priority when both are present.
CAMERA1_NAME=Front
CAMERA1_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=1&subtype=1

CAMERA2_NAME=Parking
CAMERA2_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=2&subtype=1

CAMERA3_NAME=Service Drive
CAMERA3_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=3&subtype=1

CAMERA4_NAME=Rear Lot
CAMERA4_RTSP_URL=rtsp://USERNAME:PASSWORD@192.168.2.75:554/cam/realmonitor?channel=4&subtype=1

# Analyze every Nth frame. Increase this if the PC becomes overloaded.
DETECT_EVERY=2

# Recognition profile: accurate, balanced, or fast.
# Accurate upgrades the original yolo11n default to yolo26s automatically.
RECOGNITION_PROFILE=accurate

# Seconds between AI snapshots per camera. Video capture remains continuous.
ANALYTICS_INTERVAL=0.25

# Minimum YOLO confidence. Lower values detect more distant/small objects but can increase false positives.
DETECTION_CONFIDENCE=0.20

# Higher inference resolution improves small/distant object recognition.
DETECTION_IMGSZ=960

# ByteTrack is efficient and well-suited to fixed CCTV cameras.
TRACKER_CONFIG=bytetrack.yaml

# Counting line position from top (0.0) to bottom (1.0).
COUNT_LINE_Y=0.60

# Dead-band around the visual guide line.
COUNT_HYSTERESIS=0.06

# A track is counted as 'passed' after it moves this fraction of the frame diagonal.
# 0.035 = 3.5%. Lower if distant objects move only a few pixels.
PASS_MOVEMENT_RATIO=0.035

# Minimum time a tracked object must exist before it can be counted.
PASS_MIN_TRACK_SECONDS=0.35

# Create a stopped-vehicle incident after this many seconds.
STOPPED_SECONDS=240

# Optional local OCR. This increases CPU/GPU use.
ENABLE_PLATE_OCR=false

YOLO_MODEL=yolo26s.pt

# Optional secure remote sharing. The public launcher creates a random key automatically if blank.
REMOTE_ACCESS_KEY=
REMOTE_ALLOWED_ORIGIN=https://tanvirfuad.github.io
